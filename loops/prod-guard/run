#!/usr/bin/env python3
"""prod-guard: after a deploy of main, is production up, and do the read-only @smoke specs pass?

Usage: loops/prod-guard/run <url|case-dir>
It runs loops/preview-check/run with E2E_GREP=@smoke and says what to do with the result:
exit 0: production is fine. 1: production is up, but a smoke spec failed: tell the user, do not roll back.
3: production is down: roll back to the previous deployment (loops/prod-guard/railway.py rollback).
2: cannot run. The rollback rule is the policy's autonomy.production_rollback (user, 2026-11-09).
"""
import os
import subprocess
import sys
from pathlib import Path

CHECK = Path(__file__).resolve().parent.parent / "preview-check" / "run"

if len(sys.argv) != 2:
    sys.exit("usage: run <url|case-dir>")
p = subprocess.run([sys.executable, str(CHECK), sys.argv[1]], env=dict(os.environ, E2E_GREP="@smoke"),
                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
print(p.stdout.replace("preview-check:", "prod-guard:").rstrip())
if p.returncode == 3:
    print("prod-guard: production is DOWN — roll back to the previous deployment, then tell the user.")
elif p.returncode == 1:
    print("prod-guard: production is up but a smoke spec failed — tell the user; do not roll back.")
sys.exit(p.returncode)
