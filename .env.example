# The Go API (api/). Copy to .env and change what you need; every value here is the default.

# Port the API listens on. Railway sets it in production. The Vite dev server proxies /api and /healthz here.
PORT=8080
# SQLite database file; its directory is created if missing. In the Docker image: /data/brandy.db (mount a volume at /data).
DATABASE_PATH=./data/brandy.db
# The built web app (pnpm build in web/) that the API serves, with index.html for any other path.
# In the Docker image: /app/web.
WEB_DIR=./web/dist
